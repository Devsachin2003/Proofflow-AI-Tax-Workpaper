# Backend (FastAPI). docker-compose sets DATABASE_URL / PACKET_PATH for local development.
DATABASE_URL=postgresql+psycopg://proofflow:proofflow@localhost:5433/proofflow
TEST_DATABASE_URL=postgresql+psycopg://proofflow:proofflow@localhost:5433/proofflow_test
PACKET_PATH=../reference/okafor_lindqvist_2025_packet.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo identity: the X-Demo-User header selects a seeded firm user. This is NOT production authentication.
DEMO_IDENTITY_ENABLED=true

# Optional LLM for the review assistant. Leave empty to use the deterministic, evidence-only fallback.
# LLM_PROVIDER: openai | anthropic
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Frontend (Next.js). The browser calls the API at this URL; no secrets belong here.
NEXT_PUBLIC_API_URL=http://localhost:8000
